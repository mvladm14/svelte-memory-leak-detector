{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2022",
      "dom"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "paths": {
      "svelte-memory-leak-detector": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "*.ts"
  ]
}
