{
  "name": "svelte-memory-leak-detector",
  "version": "0.1.0",
  "description": "Dev-only memory-leak detector for Svelte 5 components. A Vite plugin marks every component; a component still in memory 5 seconds after it was unmounted is reported in the console.",
  "keywords": [
    "svelte",
    "sveltekit",
    "memory-leak",
    "leak-detection",
    "vite",
    "vite-plugin",
    "devtools",
    "weakref",
    "debugging"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm test && npm run typecheck && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvladm14/svelte-memory-leak-detector.git"
  },
  "license": "MIT",
  "author": "mvladm14",
  "peerDependencies": {
    "svelte": "^5.0.0",
    "vite": ">=5"
  },
  "dependencies": {
    "magic-string": "^1.4.5"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@types/node": "^24.19.2",
    "jsdom": "^29.1.1",
    "svelte": "^5.59.1",
    "typescript": "~6.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
